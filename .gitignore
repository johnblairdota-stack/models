# Dependencies and build output
node_modules/
dist/

# Generated critic / playtest dumps (multi-GB, rebuild locally)
web-prototype/progress/
web-prototype/tmp_critic/
web-prototype/harness/out/

# Secrets and local env
.env
.env.*
*.local
# `*.local` does not match `settings.local.json` — that dot is part of the name, not an
# extension boundary — so the file sat tracked with one developer's outputStyle and permission
# allowlist in it. Match the real shape.
*.local.json
**/.claude/settings.local.json

# Runtime locks. `.claude/scheduled_tasks.lock` was committed holding a live session id and pid.
**/.claude/scheduled_tasks.lock

# OS / editor
.DS_Store
Thumbs.db
*.log
__pycache__/
*.pyc
